{
  "name": "externa-nuxt-starter",
  "version": "1.1.3",
  "private": true,
  "description": "Minimal Nuxt starter for Externa Public CMS API",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3003",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "self-check": "node scripts/self-check.mjs",
    "postinstall": "nuxt prepare"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "h3": "^1.15.11",
    "nuxt": "^4.6.2",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "@nuxt/devtools": "3.4.3"
  }
}
