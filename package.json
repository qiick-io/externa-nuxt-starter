{
  "name": "externa-nuxt-starter",
  "version": "2.0.0",
  "private": true,
  "description": "Minimal Nuxt starter for Externa Public CMS API",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3003",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "self-check": "node scripts/self-check.mjs",
    "postinstall": "nuxt prepare"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "h3": "^1.15.11",
    "nuxt": "^4.6.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.3.14"
  }
}
