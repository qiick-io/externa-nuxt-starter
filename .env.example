# Externa API — never expose EXTERNA_API_KEY to the browser (server-only runtimeConfig).
# Origin only, e.g. http://externa-core.test (no trailing slash). From your Externa APP_URL.
EXTERNA_API_URL=http://externa-core.test

# Optional Bearer secret (ek_…). Omit to use the public role. Create under Externa API keys.
# Prefer a key scoped to the starter's collections with read_only enabled (core 1.3.0+): https://docs.externa.qiick.io/docs/api-abuse-controls#api-key-scopes
EXTERNA_API_KEY=

# Optional collection slug. Leave empty to auto-pick the first readable
# collection from GET /api/v1/collections (requires public or key Read).
EXTERNA_COLLECTION=
